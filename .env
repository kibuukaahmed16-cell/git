# ---- Core ----
# T3RRI HUB's entire database - see src/lib/gistDb.js for why a Gist
# instead of Postgres. Run this once to create it:
#   GIST_DB_TOKEN=ghp_xxx node scripts/init_gist_db.mjs
# (the token needs the "gist" scope - classic token, not fine-grained)
# then paste the two values it prints below.
GIST_DB_TOKEN="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"
GIST_DB_ID="7fbdb338dde044e425c1dae1d478e514"

# Public URL of your deployed site (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://t3rri-hub.onrender.com"

# ---- Auth.js (NextAuth v5) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# GitHub OAuth App -> https://github.com/settings/developers
# Callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/github
# Scopes requested by the app: read:user, user:email, repo
AUTH_GITHUB_ID="Ov23liRSEI64kiWKFgUG"
AUTH_GITHUB_SECRET="fc41c0f34e857d11dfbf1896104b322c84243f6c"

# Google OAuth Client -> https://console.cloud.google.com/apis/credentials
# Callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated allowlist for the /admin panel - matched against
# GitHub username and/or account email at sign-in. Leave both empty
# and nobody gets admin access.
ADMIN_GITHUB_USERNAMES="kibuukaahmed16-cell"
ADMIN_EMAILS="kibuukaahmed16@gmail.com"

# ---- Token encryption ----
# 32-byte hex key used to encrypt stored GitHub tokens at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# ---- Email (welcome mail + push-result notices) ----
EMAIL_FROM="gitdeck0@gmail.com"
# Gmail Account -> Security -> 2-Step Verification -> App passwords
# (this is NOT your normal Gmail password)
EMAIL_APP_PASSWORD=""

# ---- Web push notifications ----
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BDxBwYtnqCyG_Mva1lzFcrvdy6fHSo46qJPJS2CQt9AVKgHN50l1vhyUs5Wv6GJIoxuKfWeKHIxmFJUV4QDzgg0"
VAPID_PRIVATE_KEY="PrnZGpYuRhUVPv-uG8ULYdiTx3vRhYDxUGpMd_4sCwQ"
VAPID_SUBJECT="mailto:gitdeck0@gmail.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BDxBwYtnqCyG_Mva1lzFcrvdy6fHSo46qJPJS2CQt9AVKgHN50l1vhyUs5Wv6GJIoxuKfWeKHIxmFJUV4QDzgg0"


# ---- T3RRI AI ----
# Base URL of the chat backend T3RRI AI talks to. It POSTs
# { message, instruction } and expects back { text }. The default
# below is a small unauthenticated instance with no SLA - fine to get
# started, but point this at something you control when you can:
AI_API_BASE_URL="https://api-xbha.onrender.com"

# ---- Google AdSense ----
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-0000000000000000"

# ---- Google Search Console ----
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
